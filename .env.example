SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgres://user:password@host:5432/database
# Required only when the backend runs more than one process or instance.
# REDIS_URL=redis://localhost:6379/0
ADMIN_SIGNUP_CODE=replace-with-a-private-admin-code
CORS_ALLOWED_ORIGINS=https://app.example.com
DEFAULT_VAT_RATE=7.5
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# Enable these only when every subdomain is permanently HTTPS-ready.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Public authentication abuse limits. Django REST Framework rate syntax.
AUTH_LOGIN_RATE=10/minute
AUTH_TOKEN_REFRESH_RATE=30/minute
AUTH_SIGNUP_RATE=20/hour
AUTH_PASSWORD_RESET_RATE=5/hour
AUTH_ACCOUNT_STATUS_RATE=20/minute
AUTH_REALTIME_TICKET_RATE=60/minute
